# ---- Site ----
# Public URL of the site (no trailing slash). Use your Vercel/production domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Supabase (Project Settings -> API) ----
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The anon / publishable key. Safe for the browser; protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Not required. The app uses authenticated sessions + Row Level Security.
# SUPABASE_SERVICE_ROLE_KEY=

# ---- Cloudinary (Dashboard -> API Keys) ----
# Same value as CLOUDINARY_CLOUD_NAME; needed in the browser to build image URLs.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
# Folder prefix for uploaded assets
CLOUDINARY_FOLDER=bam
